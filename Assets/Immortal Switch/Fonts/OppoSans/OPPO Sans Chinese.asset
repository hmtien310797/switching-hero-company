A\u7269\u7CBE\u534E\t\u602A\u7269\u7CBE\u83EF\r\n\u795E\u5668\u788E\u7247\t\u795E\u5668\u788E\u7247\r\n\u795E\u5668\u5347\u7EA7\u6838\u5FC3\t\u795E\u5668\u5347\u7D1A\u6838\u5FC3\r\n\u8D44\u6E90\u5E01\t\u8CC7\u6E90\u5E63\r\n\u8F6E\u76D8\u5238\t\u8F2A\u76E4\u5238\r\n\u79BB\u7EBF\u5956\u52B1\u5B9D\u7BB1\t\u96E2\u7DDA\u734E\u52F5\u5BF6\u7BB1\r\n\u5FEB\u901F\u63A0\u593A\u5238\t\u5FEB\u901F\u63A0\u596A\u5238\r\n\u89C9\u9192\u679C\u5B9E\t\u89BA\u9192\u679C\u5BE6\r\n\u6B66\u5668\u77FF\u77F3\t\u6B66\u5668\u7926\u77F3\r\n\u6B66\u5668\u5B9D\u77F3\t\u6B66\u5668\u5BF6\u77F3\r\n\u6B66\u5668\u7CBE\u534E\t\u6B66\u5668\u7CBE\u83EF\r\n\u6280\u80FD\u53EC\u5524\u5238\t\u6280\u80FD\u53EC\u559A\u5238\r\n\u82F1\u96C4\u9650\u5B9A\u53EC\u5524\u5238\t\u82F1\u96C4\u9650\u5B9A\u53EC\u559A\u5238\r\n\u73A9\u5BB6\u7ECF\u9A8C\t\u73A9\u5BB6\u7D93\u9A57\r\n\u767D\u94F6\u5E78\u8FD0\u8F6C\u76D8\u5238\t\u767D\u9280\u5E78\u904B\u8F49\u76E4\u5238\r\n\u9EC4\u91D1\u5E78\u8FD0\u8F6C\u76D8\u5238\t\u9EC3\u91D1\u5E78\u904B\u8F49\u76E4\u5238\r\n\u5E78\u8FD0\u8F6C\u76D8\u79EF\u5206\t\u5E78\u904B\u8F49\u76E4\u7A4D\u5206\r\n\u968F\u673A\u4F20\u8BF4\u82F1\u96C4\t\u96A8\u6A5F\u50B3\u8AAA\u82F1\u96C4\r\n\u968F\u673ASS\u88C5\u5907\t\u96A8\u6A5FSS\u88DD\u5099\r\n\u968F\u673ASS\u6280\u80FD\t\u96A8\u6A5FSS\u6280\u80FD\r\n\u7528\u4E8E\u5347\u7EA7\u82F1\u96C4\u548C\u88C5\u5907\u4EE5\u53CA\u8D2D\u4E70\u666E\u901A\u7269\u54C1\u7684\u5E38\u7528\u8D27\u5E01\t\u7528\u65BC\u5347\u7D1A\u82F1\u96C4\u548C\u88DD\u5099\u4EE5\u53CA\u8CFC\u8CB7\u666E\u901A\u7269\u54C1\u7684\u5E38\u7528\u8CA8\u5E63\r\n\u7528\u4E8E\u7279\u6B8A\u53EC\u5524\u548C\u9650\u65F6\u5546\u5E97\u7684\u9AD8\u7EA7\u8D27\u5E01\t\u7528\u65BC\u7279\u6B8A\u53EC\u559A\u548C\u9650\u6642\u5546\u5E97\u7684\u9AD8\u7D1A\u8CA8\u5E63\r\n\u7528\u4E8E\u53EC\u5524\u3001\u8D2D\u4E70\u7A00\u6709\u7269\u54C1\u548C\u52A0\u901F\u6210\u957F\u8FDB\u5EA6\u7684\u9AD8\u7EA7\u8D27\u5E01\t\u7528\u65BC\u53EC\u559A\u3001\u8CFC\u8CB7\u7A00\u6709\u7269\u54C1\u548C\u52A0\u901F\u6210\u9577\u9032\u5EA6\u7684\u9AD8\u7D1A\u8CA8\u5E63\r\n\u7528\u4E8E\u8FDB\u5165\u5730\u4E0B\u57CE\u3001\u6311\u6218\u9996\u9886\u548C\u53C2\u52A0\u7279\u6B8A\u6D3B\u52A8\t\u7528\u65BC\u9032\u5165\u5730\u4E0B\u57CE\u3001\u6311\u6230\u9996\u9818\u548C\u53C3\u52A0\u7279\u6B8A\u6D3B\u52D5\r\n\u901A\u8FC7\u7ADE\u6280\u573A\u5BF9\u6218\u83B7\u5F97\uFF0C\u53EF\u5728\u7ADE\u6280\u573A\u5546\u5E97\u4E2D\u4F7F\u7528\t\u900F\u904E\u7AF6\u6280\u5834\u5C0D\u6230\u7372\u5F97\uFF0C\u53EF\u5728\u7AF6\u6280\u5834\u5546\u5E97\u4E2D\u4F7F\u7528\r\n\u901A\u8FC7\u516C\u4F1A\u9996\u9886\u548C\u516C\u4F1A\u6D3B\u52A8\u83B7\u5F97\uFF0C\u53EF\u5728\u516C\u4F1A\u5546\u5E97\u4E2D\u4F7F\u7528\t\u900F\u904E\u516C\u6703\u9996\u9818\u548C\u516C\u6703\u6D3B\u52D5\u7372\u5F97\uFF0C\u53EF\u5728\u516C\u6703\u5546\u5E97\u4E2D\u4F7F\u7528\r\n\u9650\u65F6\u6D3B\u52A8\u4EE3\u5E01\uFF0C\u53EF\u5728\u6D3B\u52A8\u5546\u5E97\u4E2D\u5151\u6362\u5956\u52B1\t\u9650\u6642\u6D3B\u52D5\u4EE3\u5E63\uFF0C\u53EF\u5728\u6D3B\u52D5\u5546\u5E97\u4E2D\u514C\u63DB\u734E\u52F5\r\n\u7528\u4E8E\u5728\u5E38\u9A7B\u5361\u6C60\u4E2D\u53EC\u5524\u82F1\u96C4\t\u7528\u65BC\u5728\u5E38\u99D0\u5361\u6C60\u4E2D\u53EC\u559A\u82F1\u96C4\r\n\u7528\u4E8E\u53EC\u5524\u6B66\u5668\t\u7528\u65BC\u53EC\u559A\u6B66\u5668\r\n\u7528\u4E8E\u63D0\u5347\u82F1\u96C4\u7B49\u7EA7\t\u7528\u65BC\u63D0\u5347\u82F1\u96C4\u7B49\u7D1A\r\n\u7528\u4E8E\u89E3\u9501\u82F1\u96C4\u6216\u63D0\u5347\u82F1\u96C4\u661F\u7EA7\t\u7528\u65BC\u89E3\u9396\u82F1\u96C4\u6216\u63D0\u5347\u82F1\u96C4\u661F\u7D1A\r\n\u7528\u4E8E\u8FDB\u5316\u53F2\u8BD7\u82F1\u96C4\t\u7528\u65BC\u9032\u5316\u53F2\u8A69\u82F1\u96C4\r\n\u7528\u4E8E\u8FDB\u5316\u9AD8\u9636\u4F20\u8BF4\u82F1\u96C4\t\u7528\u65BC\u9032\u5316\u9AD8\u968E\u50B3\u8AAA\u82F1\u96C4\r\n\u7528\u4E8E\u63D0\u5347\u88C5\u5907\u7B49\u7EA7\t\u7528\u65BC\u63D0\u5347\u88DD\u5099\u7B49\u7D1A\r\n\u7528\u4E8E\u7CBE\u70BC\u6216\u5F3A\u5316\u88C5\u5907\t\u7528\u65BC\u7CBE\u7149\u6216\u5F37\u5316\u88DD\u5099\r\n\u7528\u4E8E\u82F1\u96C4\u7A81\u7834\t\u7528\u65BC\u82F1\u96C4\u7A81\u7834\r\n\u7528\u4E8E\u9AD8\u9636\u82F1\u96C4\u8D85\u8D8A\t\u7528\u65BC\u9AD8\u968E\u82F1\u96C4\u8D85\u8D8A\r\n\u5185\u542B\u4E00\u4EF6\u968F\u673A\u88C5\u5907\t\u5167\u542B\u4E00\u4EF6\u96A8\u6A5F\u88DD\u5099\r\n\u5185\u542B\u7A00\u6709\u6216\u66F4\u9AD8\u54C1\u8D28\u7684\u88C5\u5907\t\u5167\u542B\u7A00\u6709\u6216\u66F4\u9AD8\u54C1\u8CEA\u7684\u88DD\u5099\r\n\u5185\u542B\u53F2\u8BD7\u6216\u66F4\u9AD8\u54C1\u8D28\u7684\u88C5\u5907\t\u5167\u542B\u53F2\u8A69\u6216\u66F4\u9AD8\u54C1\u8CEA\u7684\u88DD\u5099\r\n\u5185\u542B\u4F20\u8BF4\u88C5\u5907\t\u5167\u542B\u50B3\u8AAA\u88DD\u5099\r\n\u7528\u4E8E\u8FDB\u5165\u7279\u6B8A\u5730\u4E0B\u57CE\t\u7528\u65BC\u9032\u5165\u7279\u6B8A\u5730\u4E0B\u57CE\r\n\u7528\u4E8E\u53C2\u52A0\u9996\u9886\u6311\u6218\t\u7528\u65BC\u53C3\u52A0\u9996\u9818\u6311\u6230\r\n\u7528\u4E8E\u6D3B\u52A8\u68CB\u76D8\u5C0F\u6E38\u620F\t\u7528\u65BC\u6D3B\u52D5\u68CB\u76E4\u5C0F\u904A\u6232\r\n\u7528\u4E8E\u7FFB\u5F00\u5BBE\u679C\u6D3B\u52A8\u4E2D\u7684\u683C\u5B50\t\u7528\u65BC\u7FFB\u958B\u8CD3\u679C\u6D3B\u52D5\u4E2D\u7684\u683C\u5B50\r\n\u7528\u4E8E\u5F00\u542F\u5BFB\u5B9D\u6D3B\u52A8\t\u7528\u65BC\u958B\u555F\u5C0B\u5BF6\u6D3B\u52D5\r\n\u5F00\u542F\u540E\u83B7\u5F97\u91D1\u5E01\t\u958B\u555F\u5F8C\u7372\u5F97\u91D1\u5E63\r\n\u5F00\u542F\u540E\u83B7\u5F97\u94BB\u77F3\t\u958B\u555F\u5F8C\u7372\u5F97\u947D\u77F3\r\n\u5185\u542B\u591A\u79CD\u5347\u7EA7\u8D44\u6E90\t\u5167\u542B\u591A\u7A2E\u5347\u7D1A\u8CC7\u6E90\r\n\u5B75\u5316\u540E\u83B7\u5F97\u53EF\u534F\u52A9\u6218\u6597\u7684\u5BA0\u7269\t\u5B75\u5316\u5F8C\u7372\u5F97\u53EF\u5354\u52A9\u6230\u9B25\u7684\u5BF5\u7269\r\n\u7528\u4E8E\u5347\u7EA7\u5BA0\u7269\t\u7528\u65BC\u5347\u7D1A\u5BF5\u7269\r\n\u7528\u4E8E\u89E3\u9501\u5723\u7269\t\u7528\u65BC\u89E3\u9396\u8056\u7269\r\n\u7528\u4E8E\u5347\u7EA7\u5723\u7269\t\u7528\u65BC\u5347\u7D1A\u8056\u7269\r\n\u7528\u4E8E\u89E3\u9501\u88AB\u52A8\u52A0\u6210\t\u7528\u65BC\u89E3\u9396\u88AB\u52D5\u52A0\u6210\r\n\u7528\u4E8E\u5347\u7EA7\u602A\u7269\u5361\t\u7528\u65BC\u5347\u7D1A\u602A\u7269\u5361\r\n\u7528\u4E8E\u89E3\u9501\u795E\u5668\t\u7528\u65BC\u89E3\u9396\u795E\u5668\r\n\u7528\u4E8E\u5347\u7EA7\u795E\u5668\t\u7528\u65BC\u5347\u7D1A\u795E\u5668\r\n\u7528\u4E8E\u6D3B\u52A8\u6392\u884C\u699C\u7684\u8D27\u5E01\t\u7528\u65BC\u6D3B\u52D5\u6392\u884C\u699C\u7684\u8CA8\u5E63\r\n\u7528\u4E8E\u8F6C\u52A8\u5E78\u8FD0\u8F6C\u76D8\t\u7528\u65BC\u8F49\u52D5\u5E78\u904B\u8F49\u76E4\r\n\u5185\u542B\u79BB\u7EBF\u671F\u95F4\u79EF\u7D2F\u7684\u6302\u673A\u5956\u52B1\t\u5167\u542B\u96E2\u7DDA\u671F\u9593\u7D2F\u7A4D\u7684\u639B\u6A5F\u734E\u52F5\r\n\u7528\u4E8E\u7ACB\u5373\u9886\u53D6\u6302\u673A\u5956\u52B1\t\u7528\u65BC\u7ACB\u5373\u9818\u53D6\u639B\u6A5F\u734E\u52F5\r\n\u7528\u4E8E\u89C9\u9192\u82F1\u96C4\uFF0C\u53EF\u4ECE\u94BB\u77F3\u5730\u4E0B\u57CE\u4E2D\u83B7\u5F97\t\u7528\u65BC\u89BA\u9192\u82F1\u96C4\uFF0C\u53EF\u5F9E\u947D\u77F3\u5730\u4E0B\u57CE\u4E2D\u7372\u5F97\r\n\u7528\u4E8E\u5347\u7EA7\u6B66\u5668\uFF0C\u53EF\u4ECE\u88C5\u5907\u5730\u4E0B\u57CE\u4E2D\u83B7\u5F97\t\u7528\u65BC\u5347\u7D1A\u6B66\u5668\uFF0C\u53EF\u5F9E\u88DD\u5099\u5730\u4E0B\u57CE\u4E2D\u7372\u5F97\r\n\u7528\u4E8E\u5F3A\u5316\u6B66\u5668\uFF0C\u53EF\u4ECE\u88C5\u5907\u5730\u4E0B\u57CE\u4E2D\u83B7\u5F97\t\u7528\u65BC\u5F37\u5316\u6B66\u5668\uFF0C\u53EF\u5F9E\u88DD\u5099\u5730\u4E0B\u57CE\u4E2D\u7372\u5F97\r\n\u7528\u4E8E\u9AD8\u7EA7\u6B66\u5668\u7CBE\u70BC\uFF0C\u53EF\u4ECE\u88C5\u5907\u5730\u4E0B\u57CE\u4E2D\u83B7\u5F97\t\u7528\u65BC\u9AD8\u7D1A\u6B66\u5668\u7CBE\u7149\uFF0C\u53EF\u5F9E\u88DD\u5099\u5730\u4E0B\u57CE\u4E2D\u7372\u5F97\r\n\u7528\u4E8E\u5728\u5E38\u9A7B\u5361\u6C60\u4E2D\u53EC\u5524\u6280\u80FD\t\u7528\u65BC\u5728\u5E38\u99D0\u5361\u6C60\u4E2D\u53EC\u559A\u6280\u80FD\r\n\u7528\u4E8E\u5728\u6D3B\u52A8\u5361\u6C60\u4E2D\u53EC\u5524\u82F1\u96C4\t\u7528\u65BC\u5728\u6D3B\u52D5\u5361\u6C60\u4E2D\u53EC\u559A\u82F1\u96C4\r\n\u7528\u4E8E\u63D0\u5347\u73A9\u5BB6\u7B49\u7EA7\t\u7528\u65BC\u63D0\u5347\u73A9\u5BB6\u7B49\u7D1A\r\n\u7528\u4E8E\u8F6C\u52A8\u666E\u901A\u5E78\u8FD0\u8F6C\u76D8\t\u7528\u65BC\u8F49\u52D5\u666E\u901A\u5E78\u904B\u8F49\u76E4\r\n\u7528\u4E8E\u8F6C\u52A8\u9AD8\u7EA7\u5E78\u8FD0\u8F6C\u76D8\t\u7528\u65BC\u8F49\u52D5\u9AD8\u7D1A\u5E78\u904B\u8F49\u76E4\r\n\u7528\u4E8E\u5728\u5E78\u8FD0\u8F6C\u76D8\u5546\u5E97\u4E2D\u5151\u6362\u5956\u52B1\t\u7528\u65BC\u5728\u5E78\u904B\u8F49\u76E4\u5546\u5E97\u4E2D\u514C\u63DB\u734E\u52F5\r\n\u5F00\u542F\u540E\u83B7\u5F97\u4E00\u540D\u968F\u673A\u82F1\u96C4\t\u958B\u555F\u5F8C\u7372\u5F97\u4E00\u540D\u96A8\u6A5F\u82F1\u96C4\r\n\u5F00\u542F\u540E\u83B7\u5F97\u4E00\u4EF6\u968F\u673A\u88C5\u5907\t\u958B\u555F\u5F8C\u7372\u5F97\u4E00\u4EF6\u96A8\u6A5F\u88DD\u5099\r\n\u5F00\u542F\u540E\u83B7\u5F97\u4E00\u4E2A\u968F\u673A\u6280\u80FD\t\u958B\u555F\u5F8C\u7372\u5F97\u4E00\u500B\u96A8\u6A5F\u6280\u80FD\r\n\u514D\u8D39\u793C\u5305\t\u514D\u8CBB\u79AE\u5305\r\n\u5C0F\u578B\u767D\u94F6\u5238\u793C\u5305\t\u5C0F\u578B\u767D\u9280\u5238\u79AE\u5305\r\n\u5927\u578B\u767D\u94F6\u5238\u793C\u5305\t\u5927\u578B\u767D\u9280\u5238\u79AE\u5305\r\n\u5C0F\u578B\u9EC4\u91D1\u5238\u793C\u5305\t\u5C0F\u578B\u9EC3\u91D1\u5238\u79AE\u5305\r\n\u5927\u578B\u9EC4\u91D1\u5238\u793C\u5305\t\u5927\u578B\u9EC3\u91D1\u5238\u79AE\u5305\r\n\u5C0F\u578B\u5E78\u8FD0\u79EF\u5206\u793C\u5305\t\u5C0F\u578B\u5E78\u904B\u7A4D\u5206\u79AE\u5305\r\n\u5927\u578B\u5E78\u8FD0\u79EF\u5206\u793C\u5305\t\u5927\u578B\u5E78\u904B\u7A4D\u5206\u79AE\u5305\r\n\u5E78\u8FD0\u8F6C\u76D8\u7EC4\u5408\u793C\u5305\t\u5E78\u904B\u8F49\u76E4\u7D44\u5408\u79AE\u5305\r\n\u5E78\u8FD0\u8F6C\u76D8\u8C6A\u534E\u7EC4\u5408\u793C\u5305\t\u5E78\u904B\u8F49\u76E4\u8C6A\u83EF\u7D44\u5408\u79AE\u5305\r\n\u51B0\u9F99\u793C\u5305
      \xA56\t\u51B0\u9F8D\u79AE\u5305 NT$30\r\n\u51B0\u9F99\u793C\u5305 \xA512\t\u51B0\u9F8D\u79AE\u5305
      NT$60\r\n\u51B0\u9F99\u793C\u5305 \xA518\t\u51B0\u9F8D\u79AE\u5305 NT$90\r\n\u51B0\u9F99\u793C\u5305
      \xA530\t\u51B0\u9F8D\u79AE\u5305 NT$150\r\n\u51B0\u9F99\u793C\u5305 \xA568\t\u51B0\u9F8D\u79AE\u5305
