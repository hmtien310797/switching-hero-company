BCF\u65E5\u52A9\u529B\u793C\u5305\t\u6BCF\u65E5\u52A9\u529B\u79AE\u5305\r\n\u53EC\u5524\u793C\u5305\t\u53EC\u559A\u79AE\u5305\r\n\u6210\u957F\u793C\u5305\t\u6210\u9577\u79AE\u5305\r\n\u88C5\u5907\u793C\u5305\t\u88DD\u5099\u79AE\u5305\r\n\u6BCF\u5468\u7279\u60E0\t\u6BCF\u9031\u7279\u60E0\r\n\u5723\u7269\u793C\u5305\t\u8056\u7269\u79AE\u5305\r\n\u53F2\u8BD7\u82F1\u96C4\u793C\u5305\t\u53F2\u8A69\u82F1\u96C4\u79AE\u5305\r\n\u6B66\u5668\u5927\u5E08\u793C\u5305\t\u6B66\u5668\u5927\u5E2B\u79AE\u5305\r\n\u4F20\u8BF4\u793C\u5305\t\u50B3\u8AAA\u79AE\u5305\r\n\u8D85\u8D8A\u793C\u5305\t\u8D85\u8D8A\u79AE\u5305\r\n\u81F3\u5C0A\u8D85\u503C\u793C\u5305\t\u81F3\u5C0A\u8D85\u503C\u79AE\u5305\r\n\u6BCF\u5468\u80FD\u91CF\u901A\u884C\u8BC1\t\u6BCF\u9031\u80FD\u91CF\u901A\u884C\u8B49\r\n\u6BCF\u65E5\u80FD\u91CF\u793C\u5305\t\u6BCF\u65E5\u80FD\u91CF\u79AE\u5305\r\n\u6708\u5361\t\u6708\u5361\r\n\u9AD8\u7EA7\u6708\u5361\t\u9AD8\u7D1A\u6708\u5361\r\n\u8BF7\u5B8C\u6574\u586B\u5199\u6240\u6709\u4FE1\u606F\u3002\t\u8ACB\u5B8C\u6574\u586B\u5BEB\u6240\u6709\u8CC7\u8A0A\u3002\r\n\u5FD8\u8BB0\u5BC6\u7801\t\u5FD8\u8A18\u5BC6\u78BC\r\n\u4E24\u6B21\u5BC6\u7801\u4E0D\u4E00\u81F4\t\u5169\u6B21\u5BC6\u78BC\u4E0D\u4E00\u81F4\r\n\u8BF7\u8F93\u5165ID\t\u8ACB\u8F38\u5165ID\r\n\u8BF7\u8F93\u5165\u5BC6\u7801\t\u8ACB\u8F38\u5165\u5BC6\u78BC\r\n\u5185\u5BB9\u5305\u542B\u8FDD\u89C4\u8BCD\u8BED\t\u5167\u5BB9\u5305\u542B\u9055\u898F\u8A5E\u8A9E\r\n\u7528\u6237\u540D\u5FC5\u987B\u4E3A4\u81F318\u4E2A\u5B57\u7B26\uFF0C\u4E14\u4E0D\u80FD\u5305\u542B\u7279\u6B8A\u5B57\u7B26\t\u4F7F\u7528\u8005\u540D\u7A31\u5FC5\u9808\u70BA4\u81F318\u500B\u5B57\u5143\uFF0C\u4E14\u4E0D\u80FD\u5305\u542B\u7279\u6B8A\u5B57\u5143\r\n\u767B\u5F55\t\u767B\u5165\r\n\u6CE8\u518C\t\u8A3B\u518A\r\n\u8FD4\u56DE\t\u8FD4\u56DE\r\n\u8BF7\u8F93\u5165\u5185\u5BB9...\t\u8ACB\u8F38\u5165\u5167\u5BB9...\r\n\u8BBE\u7F6E\t\u8A2D\u5B9A\r\n\u73A9\u5BB6\u4FE1\u606F\t\u73A9\u5BB6\u8CC7\u8A0A\r\n\u89D2\u8272\u540D\u79F0\t\u89D2\u8272\u540D\u7A31\r\n\u73A9\u5BB6ID\t\u73A9\u5BB6ID\r\n\u7ED1\u5B9A\u8D26\u53F7\t\u7D81\u5B9A\u5E33\u865F\r\n\u5DF2\u7ED1\u5B9A\u8D26\u53F7\t\u5DF2\u7D81\u5B9A\u5E33\u865F\r\n\u5956\u52B1\u5DF2\u9886\u53D6\t\u734E\u52F5\u5DF2\u9818\u53D6\r\n\u9000\u51FA\u767B\u5F55\t\u767B\u51FA\r\n\u5220\u9664\u8D26\u53F7\t\u522A\u9664\u5E33\u865F\r\n\u8BED\u8A00\t\u8A9E\u8A00\r\n\u5176\u4ED6\u4FE1\u606F\t\u5176\u4ED6\u8CC7\u8A0A\r\n\u670D\u52A1\u6761\u6B3E\t\u670D\u52D9\u689D\u6B3E\r\n\u9690\u79C1\u653F\u7B56\t\u96B1\u79C1\u6B0A\u653F\u7B56\r\n\u5BA2\u670D\u652F\u6301\t\u5BA2\u670D\u652F\u63F4\r\n\u8F93\u5165\u793C\u5305\u7801\t\u8F38\u5165\u79AE\u5305\u78BC\r\n\u6392\u884C\u699C\t\u6392\u884C\u699C\r\n\u6392\u540D\t\u6392\u540D\r\n\u540D\u79F0\t\u540D\u7A31\r\n\u6700\u9AD8\u7B49\u7EA7\t\u6700\u9AD8\u7B49\u7D1A\r\n\u5956\u52B1\t\u734E\u52F5\r\n\u8D26\u53F7\t\u5E33\u865F\r\n\u5176\u4ED6\t\u5176\u4ED6\r\n\u753B\u8D28\t\u756B\u8CEA\r\n\u56FE\u50CF\t\u5716\u50CF\r\n\u4F4E\t\u4F4E\r\n\u4E2D\t\u4E2D\r\n\u9AD8\t\u9AD8\r\n\u5E27\u7387\t\u5E40\u7387\r\n\u7EC6\u8282\u8D28\u91CF\t\u7D30\u7BC0\u54C1\u8CEA\r\n\u80CC\u666F\u97F3\u4E50\t\u80CC\u666F\u97F3\u6A02\r\n\u6218\u6597\u97F3\u4E50\t\u6230\u9B25\u97F3\u6A02\r\n\u5C4F\u5E55\u9707\u52A8\t\u87A2\u5E55\u9707\u52D5\r\n\u4F24\u5BB3\u663E\u793A\t\u50B7\u5BB3\u986F\u793A\r\n\u81EA\u52A8\u5173\u95ED\u5C4F\u5E55\t\u81EA\u52D5\u95DC\u9589\u87A2\u5E55\r\n\u901A\u77E5\t\u901A\u77E5\r\n\u6280\u80FD\u7279\u6548\t\u6280\u80FD\u7279\u6548\r\n\u663E\u793A\u602A\u7269\t\u986F\u793A\u602A\u7269\r\n\u5173\u95ED\t\u95DC\u9589\r\n\u5F00\u542F\t\u958B\u555F\r\n\u58F0\u97F3\u8BBE\u7F6E\t\u8072\u97F3\u8A2D\u5B9A\r\n\u97F3\u91CF\t\u97F3\u91CF\r\n\u603B\u97F3\u91CF\t\u7E3D\u97F3\u91CF\r\n\u81EA\u52A8\u5173\u95ED\u5C4F\u5E55\t\u81EA\u52D5\u95DC\u9589\u87A2\u5E55\r\n\u63A5\u6536\u6D3B\u52A8\u901A\u77E5\t\u63A5\u6536\u6D3B\u52D5\u901A\u77E5\r\n\u51FB\u8D25\u7B2C1-5\u5173\u9996\u9886\t\u64CA\u6557\u7B2C1-5\u95DC\u9996\u9818\r\n\u53EC\u55241\u540D\u82F1\u96C4\t\u53EC\u559A1\u540D\u82F1\u96C4\r\n\u4E3A1\u540D\u82F1\u96C4\u88C5\u59071\u4EF6\u6B66\u5668\t\u70BA1\u540D\u82F1\u96C4\u88DD\u50991\u4EF6\u6B66\u5668\r\n\u5F3A\u5316\u88C5\u5907\u81F3Lv.5\t\u5F37\u5316\u88DD\u5099\u81F3Lv.5\r\n\u82F1\u96C4\u5347\u7EA75\u6B21\t\u82F1\u96C4\u5347\u7D1A5\u6B21\r\n\u8D62\u5F971\u573A\u7ADE\u6280\u573A\u6218\u6597\t\u8D0F\u5F971\u5834\u7AF6\u6280\u5834\u6230\u9B25\r\n\u5B8C\u62101\u6B21\u5730\u4E0B\u57CE\u6311\u6218\t\u5B8C\u62101\u6B21\u5730\u4E0B\u57CE\u6311\u6230\r\n\u5347\u7EA71\u4E2A\u6280\u80FD\t\u5347\u7D1A1\u500B\u6280\u80FD\r\n\u9886\u53D61\u6B21\u6302\u673A\u5956\u52B1\t\u9818\u53D61\u6B21\u639B\u6A5F\u734E\u52F5\r\n\u901A\u5173\u7B2C{0}\u7AE0\uFF0D\u5173\u5361{1}\t\u901A\u95DC\u7B2C{0}\u7AE0\uFF0D\u95DC\u5361{1}\r\n\u767B\u5F55\u6E38\u620F\t\u767B\u5165\u904A\u6232\r\n\u6D88\u706D150\u4E2A\u602A\u7269\t\u6D88\u6EC5150\u500B\u602A\u7269\r\n\u51FB\u8D253\u4E2A\u9996\u9886\t\u64CA\u65573\u500B\u9996\u9818\r\n\u53EC\u55245\u6B21\t\u53EC\u559A5\u6B21\r\n\u5F3A\u5316\u88C5\u59075\u6B21\t\u5F37\u5316\u88DD\u50995\u6B21\r\n\u82F1\u96C4\u5347\u7EA75\u6B21\t\u82F1\u96C4\u5347\u7D1A5\u6B21\r\n\u9886\u53D62\u6B21\u6302\u673A\u5956\u52B1\t\u9818\u53D62\u6B21\u639B\u6A5F\u734E\u52F5\r\n\u8FDB\u884C3\u573A\u7ADE\u6280\u573A\u6218\u6597\t\u9032\u884C3\u5834\u7AF6\u6280\u5834\u6230\u9B25\r\n\u8FDB\u5165\u5730\u4E0B\u57CE2\u6B21\t\u9032\u5165\u5730\u4E0B\u57CE2\u6B21\r\n\u5347\u7EA7\u6280\u80FD3\u6B21\t\u5347\u7D1A\u6280\u80FD3\u6B21\r\n\u5B8C\u621030\u4E2A\u6BCF\u65E5\u4EFB\u52A1\t\u5B8C\u621030\u500B\u6BCF\u65E5\u4EFB\u52D9\r\n\u6D88\u706D3000\u4E2A\u602A\u7269\t\u6D88\u6EC53000\u500B\u602A\u7269\r\n\u51FB\u8D2550\u4E2A\u9996\u9886\t\u64CA\u655750\u500B\u9996\u9818\r\n\u53EC\u5524100\u6B21\t\u53EC\u559A100\u6B21\r\n\u8D62\u5F9730\u573A\u7ADE\u6280\u573A\u6218\u6597\t\u8D0F\u5F9730\u5834\u7AF6\u6280\u5834\u6230\u9B25\r\n\u8FDB\u5165\u5730\u4E0B\u57CE14\u6B21\t\u9032\u5165\u5730\u4E0B\u57CE14\u6B21\r\n\u5F3A\u5316\u88C5\u590770\u6B21\t\u5F37\u5316\u88DD\u509970\u6B21\r\n\u5347\u7EA7\u6280\u80FD30\u6B21\t\u5347\u7D1A\u6280\u80FD30\u6B21\r\n\u672C\u5468\u53EC\u5524{0}\u6B21\t\u672C\u9031\u53EC\u559A{0}\u6B21\r\n\u672C\u5468\u51FB\u8D25{0}\u4E2A\u654C\u4EBA\t\u672C\u9031\u64CA\u6557{0}\u500B\u6575\u4EBA\r\n\u672C\u5468\u51FB\u8D25{0}\u4E2A\u9996\u9886\t\u672C\u9031\u64CA\u6557{0}\u500B\u9996\u9818\r\n\u672C\u5468\u8D62\u5F97{0}\u573A\u7ADE\u6280\u573A\u6218\u6597\t\u672C\u9031\u8D0F\u5F97{0}\u5834\u7AF6\u6280\u5834\u6230\u9B25\r\n\u672C\u5468\u5B8C\u6210{0}\u6B21\u526F\u672C\t\u672C\u9031\u5B8C\u6210{0}\u6B21\u526F\u672C\r\n\u672C\u5468\u5F3A\u5316\u88C5\u5907{0}\u6B21\t\u672C\u9031\u5F37\u5316\u88DD\u5099{0}\u6B21\r\n\u5F81\u670D\uFF1A\u7B2C{0}\u7AE0\uFF0D\u5173\u5361{1}\t\u5F81\u670D\uFF1A\u7B2C{0}\u7AE0\uFF0D\u95DC\u5361{1}\r\n\u6536\u96C6\uFF1A\u62E5\u6709{0}\u540D\u82F1\u96C4\t\u6536\u96C6\uFF1A\u64C1\u6709{0}\u540D\u82F1\u96C4\r\n\u5C60\u622E\uFF1A\u51FB\u8D25{0}\u53EA\u602A\u7269\t\u5C60\u622E\uFF1A\u64CA\u6557{0}\u96BB\u602A\u7269\r\n\u9996\u9886\u730E\u624B\uFF1A\u51FB\u8D25{0}\u4E2A\u9996\u9886\t\u9996\u9818\u7375\u624B\uFF1A\u64CA\u6557{0}\u500B\u9996\u9818\r\n\u94C1\u5320\uFF1A\u5F3A\u5316{0}\u6B21\t\u9435\u5320\uFF1A\u5F37\u5316{0}\u6B21\r\n\u6218\u529B\uFF1A\u8FBE\u5230{0}\u6218\u529B\t\u6230\u529B\uFF1A\u9054\u5230{0}\u6230\u529B\r\n\u7B49\u7EA7\uFF1A\u8FBE\u5230{0}\u7EA7\t\u7B49\u7D1A\uFF1A\u9054\u5230{0}\u7D1A\r\n\u89D2\u6597\u58EB\uFF1A\u8D62\u5F97{0}\u573A\u7ADE\u6280\u573A\u6218\u6597\t\u89D2\u9B25\u58EB\uFF1A\u8D0F\u5F97{0}\u5834\u7AF6\u6280\u5834\u6230\u9B25\r\n\u63A2\u9669\u5BB6\uFF1A\u5B8C\u6210{0}\u6B21\u526F\u672C\t\u63A2\u96AA\u5BB6\uFF1A\u5B8C\u6210{0}\u6B21\u526F\u672C\r\n\u6280\u80FD\u5927\u5E08\uFF1A\u5347\u7EA7\u6280\u80FD{0}\u6B21\t\u6280\u80FD\u5927\u5E2B\uFF1A\u5347\u7D1A\u6280\u80FD{0}\u6B21\r\n\u8BAD\u7EC3\uFF1A\u82F1\u96C4\u5347\u7EA7{0}\u6B21\t\u8A13\u7DF4\uFF1A\u82F1\u96C4\u5347\u7D1A{0}\u6B21\r\n\u6302\u673A\uFF1A\u9886\u53D6\u6302\u673A\u5956\u52B1{0}\u6B21\t\u639B\u6A5F\uFF1A\u9818\u53D6\u639B\u6A5F\u734E\u52F5{0}\u6B21\r\n\u953B\u9020\uFF1A\u6253\u9020{0}\u4EF6\u88C5\u5907\t\u935B\u9020\uFF1A\u6253\u9020{0}\u4EF6\u88DD\u5099\r\n\u8F6C\u5316\uFF1A\u8F6C\u5316{0}\u6B21\t\u8F49\u5316\uFF1A\u8F49\u5316{0}\u6B21\r\n\u52E4\u594B\uFF1A\u5B8C\u6210{0}\u4E2A\u6BCF\u65E5\u4EFB\u52A1\t\u52E4\u596E\uFF1A\u5B8C\u6210{0}\u500B\u6BCF\u65E5\u4EFB\u52D9\r\n\u6325\u91D1\u5982\u571F\uFF1A\u6D88\u8017{0}\u91D1\u5E01\t\u63EE\u91D1\u5982\u571F\uFF1A\u6D88\u8017{0}\u91D1\u5E63\r\n\u6B66\u88C5\uFF1A\u7A7F\u6234\u88C5\u5907{0}\u6B21\t\u6B66\u88DD\uFF1A\u7A7F\u6234\u88DD\u5099{0}\u6B21\r\n\u575A\u6301\u4E0D\u61C8\uFF1A\u5B8C\u6210{0}\u4E2A\u6BCF\u5468\u4EFB\u52A1\t\u5805\u6301\u4E0D\u61C8\uFF1A\u5B8C\u6210{0}\u500B\u6BCF\u9031\u4EFB\u52D9\r\n\u53EC\u5524\u82F1\u96C4{0}\u6B21\t\u53EC\u559A\u82F1\u96C4{0}\u6B21\r\n\u53EC\u5524\u6B66\u5668{0}\u6B21\t\u53EC\u559A\u6B66\u5668{0}\u6B21\r\n\u53EC\u5524\u6280\u80FD{0}\u6B21\t\u53EC\u559A\u6280\u80FD{0}\u6B21\r\n\u8F6C\u5316{0}\u6B21\t\u8F49\u5316{0}\u6B21\r\n\u5B8C\u6210{0}\u6B21\u526F\u672C\t\u5B8C\u6210{0}\u6B21\u526F\u672C\r\n\u6E38\u73A9{0}\u5206\u949F\t\u904A\u73A9{0}\u5206\u9418\r\n\u51FB\u8D25{0}\u53EA\u602A\u7269\t\u64CA\u6557{0}\u96BB\u602A\u7269\r\n\u51FB\u8D25{0}\u4E2A\u9996\u9886\t\u64CA\u6557{0}\u500B\u9996\u9818\r\n\u5F3A\u5316\u88C5\u5907{0}\u6B21\t\u5F37\u5316\u88DD\u5099{0}\u6B21\r\n\u953B\u9020\u88C5\u5907{0}\u6B21\t\u935B\u9020\u88DD\u5099{0}\u6B21\r\n\u8D62\u5F97{0}\u573A\u7ADE\u6280\u573A\u6218\u6597\t\u8D0F\u5F97{0}\u5834\u7AF6\u6280\u5834\u6230\u9B25\r\n\u82F1\u96C4\u5347\u7EA7{0}\u6B21\t\u82F1\u96C4\u5347\u7D1A{0}\u6B21\r\n\u9886\u53D6\u6302\u673A\u5956\u52B1{0}\u6B21\t\u9818\u53D6\u639B\u6A5F\u734E\u52F5{0}\u6B21\r\n\u6D88\u8017{0}\u91D1\u5E01\t\u6D88\u8017{0}\u91D1\u5E63\r\n1-5
      -> 105\t1-5 -> 105\r\n\u53EC\u55241\u540D\u82F1\u96C4\t\u53EC\u559A1\u540D\u82F1\u96C4\r\n\u4E3A\u82F1\u96C4\u88C5\u59071\u628A\u6B66\u5668\t\u70BA\u82F1\u96C4\u88DD\u50991\u628A\u6B66\u5668\r\n\u5C06\u88C5\u5907\u5F3A\u5316\u81F3Lv.5\t\u5C07\u88DD\u5099\u5F37\u5316\u81F3Lv.5\r\n\u82F1\u96C4\u5347\u7EA75\u6B21\t\u82F1\u96C4\u5347\u7D1A5\u6B21\r\n\u8D62\u5F971\u573A\u7ADE\u6280\u573A\u6218\u6597\t\u8D0F\u5F971\u5834\u7AF6\u6280\u5834\u6230\u9B25\r\n\u5B8C\u62101\u6B21\u5730\u4E0B\u57CE\t\u5B8C\u62101\u6B21\u5730\u4E0B\u57CE\r\n\u5347\u7EA71\u4E2A\u6280\u80FD\t\u5347\u7D1A1\u500B\u6280\u80FD\r\n\u9886\u53D61\u6B21\u6302\u673A\u5956\u52B1\t\u9818\u53D61\u6B21\u639B\u6A5F\u734E\u52F5\r\n\u7B2C{0}\u7AE0\uFF0C\u5168\u670D\u5173\u5361{1}\t\u7B2C{0}\u7AE0\uFF0C\u5168\u670D\u95DC\u5361{1}\r\n\u767B\u5F55\u6E38\u620F\t\u767B\u5165\u904A\u6232\r\n\u51FB\u8D25{0}\u540D\u654C\u4EBA\t\u64CA\u6557{0}\u540D\u6575\u4EBA\r\n\u51FB\u8D25{0}\u4E2A\u9996\u9886\t\u64CA\u6557{0}\u500B\u9996\u9818\r\n\u53EC\u5524{0}\u6B21\t\u53EC\u559A{0}\u6B21\r\n\u5F3A\u5316\u88C5\u5907{0}\u6B21\t\u5F37\u5316\u88DD\u5099{0}\u6B21\r\n\u82F1\u96C4\u5347\u7EA7{0}\u6B21\t\u82F1\u96C4\u5347\u7D1A{0}\u6B21\r\n\u9886\u53D6{0}\u6B21\u6302\u673A\u5956\u52B1\t\u9818\u53D6{0}\u6B21\u639B\u6A5F\u734E\u52F5\r\n\u53C2\u52A0{0}\u573A\u7ADE\u6280\u573A\u6218\u6597\t\u53C3\u52A0{0}\u5834\u7AF6\u6280\u5834\u6230\u9B25\r\n\u8FDB\u5165\u5730\u4E0B\u57CE{0}\u6B21\t\u9032\u5165\u5730\u4E0B\u57CE{0}\u6B21\r\n\u5347\u7EA7\u6280\u80FD{0}\u6B21\t\u5347\u7D1A\u6280\u80FD{0}\u6B21\r\n\u5B8C\u6210{0}\u4E2A\u6BCF\u65E5\u4EFB\u52A1\t\u5B8C\u6210{0}\u500B\u6BCF\u65E5\u4EFB\u52D9\r\n\u51FB\u8D25{0}\u4E2A\u654C\u4EBA\t\u64CA\u6557{0}\u500B\u6575\u4EBA\r\n\u51FB\u8D25{0}\u4E2A\u9996\u9886\t\u64CA\u6557{0}\u500B\u9996\u9818\r\n\u53EC\u5524{0}\u6B21\t\u53EC\u559A{0}\u6B21\r\n\u8D62\u5F97{0}\u573A\u7ADE\u6280\u573A\u6218\u6597\t\u8D0F\u5F97{0}\u5834\u7AF6\u6280\u5834\u6230\u9B25\r\n\u8FDB\u5165\u5730\u4E0B\u57CE{0}\u6B21\t\u9032\u5165\