05\r\n\u53EC\u5524{0}\u6B21\t\u53EC\u559A{0}\u6B21\r\n\u54DF\uFF0C\u65B0\u4EBA\uFF01\u6211\u662F\u5361\u5854\uFF0C\u8FD9\u7247\u6D77\u57DF\u6700\u8001\u7EC3\u7684\u8239\u957F\u3002\u51C6\u5907\u597D\u626C\u5E06\u524D\u5F80\u9B54\u738B\u4E4B\u5854\u4E86\u5417\uFF1F\t\u55B2\uFF0C\u65B0\u4EBA\uFF01\u6211\u662F\u5361\u5854\uFF0C\u9019\u7247\u6D77\u57DF\u6700\u8001\u7DF4\u7684\u8239\u9577\u3002\u6E96\u5099\u597D\u63DA\u5E06\u524D\u5F80\u9B54\u738B\u4E4B\u5854\u4E86\u55CE\uFF1F\r\n\uFF08\u8DF3\u8FC7\uFF09\u51FA\u53D1\u5427\uFF01\u6CA1\u65F6\u95F4\u78E8\u8E6D\u4E86\uFF0C\u5C0F\u5B50\uFF01\t\uFF08\u8DF3\u904E\uFF09\u51FA\u767C\u5427\uFF01\u6C92\u6642\u9593\u78E8\u8E6D\u4E86\uFF0C\u5C0F\u5B50\uFF01\r\n\u770B\u5230\u4E86\u5417\uFF1F\u4F60\u7684\u8239\u5458\u4F1A\u81EA\u52A8\u6218\u6597\u3002\u4F60\u7684\u4EFB\u52A1\u662F\u6307\u6325\u4ED6\u4EEC\uFF0C\u800C\u4E0D\u662F\u4EB2\u81EA\u6325\u5251\uFF01\t\u770B\u5230\u4E86\u55CE\uFF1F\u4F60\u7684\u8239\u54E1\u6703\u81EA\u52D5\u6230\u9B25\u3002\u4F60\u7684\u4EFB\u52D9\u662F\u6307\u63EE\u4ED6\u5011\uFF0C\u800C\u4E0D\u662F\u89AA\u81EA\u63EE\u528D\uFF01\r\n\u5148\u8BA9\u4ED6\u4EEC\u70ED\u70ED\u8EAB\u5427\u3002\t\u5148\u8B93\u4ED6\u5011\u71B1\u71B1\u8EAB\u5427\u3002\r\n\u70B9\u51FB\u8FD9\u91CC\u9009\u62E9\u4F60\u7684\u4E3B\u529B\u82F1\u96C4\uFF01\u4F18\u79C0\u7684\u8239\u957F\u603B\u77E5\u9053\u8BE5\u6D3E\u8C01\u51FA\u6218\u3002\t\u9EDE\u64CA\u9019\u88E1\u9078\u64C7\u4F60\u7684\u4E3B\u529B\u82F1\u96C4\uFF01\u512A\u79C0\u7684\u8239\u9577\u7E3D\u77E5\u9053\u8A72\u6D3E\u8AB0\u51FA\u6230\u3002\r\n\u8FD9\u662F\u8239\u957F\u7684\u72EC\u95E8\u79D8\u8BC0\uFF01\u5207\u6362\u5230\u53E6\u4E00\u4F4D\u82F1\u96C4\u5373\u53EF\u91CA\u653E\u6BC1\u706D\u6027\u7684\u7EC8\u6781\u6280\u80FD\u3002\u4E0A\u5427\uFF01\t\u9019\u662F\u8239\u9577\u7684\u7368\u9580\u7955\u8A23\uFF01\u5207\u63DB\u5230\u53E6\u4E00\u4F4D\u82F1\u96C4\u5373\u53EF\u91CB\u653E\u6BC0\u6EC5\u6027\u7684\u7D42\u6975\u6280\u80FD\u3002\u4E0A\u5427\uFF01\r\n\u5FD9\u4E0D\u8FC7\u6765\uFF1F\u5F00\u542F\u81EA\u52A8\u6218\u6597\u5427\u3002\u5C31\u7B97\u4F60\u53BB\u6CE1\u676F\u8336\uFF0C\u8239\u5458\u4E5F\u4F1A\u7EE7\u7EED\u6218\u6597\u3002\t\u5FD9\u4E0D\u904E\u4F86\uFF1F\u958B\u555F\u81EA\u52D5\u6230\u9B25\u5427\u3002\u5C31\u7B97\u4F60\u53BB\u6CE1\u676F\u8336\uFF0C\u8239\u54E1\u4E5F\u6703\u7E7C\u7E8C\u6230\u9B25\u3002\r\n\u5077\u61D2\u4E00\u4E0B\u4E5F\u6CA1\u5173\u7CFB\uFF0C\u53EA\u8981\u5B9D\u85CF\u4E0D\u65AD\u589E\u52A0\u5C31\u884C\uFF01\t\u5077\u61F6\u4E00\u4E0B\u4E5F\u6C92\u95DC\u4FC2\uFF0C\u53EA\u8981\u5BF6\u85CF\u4E0D\u65B7\u589E\u52A0\u5C31\u884C\uFF01\r\n\u5F00\u542F\u81EA\u52A8\u7EC8\u6781\u6280\u80FD\uFF01\u7EC8\u6781\u6280\u80FD\u4F1A\u5728\u6700\u4F73\u65F6\u673A\u81EA\u52A8\u91CA\u653E\u3002\t\u958B\u555F\u81EA\u52D5\u7D42\u6975\u6280\u80FD\uFF01\u7D42\u6975\u6280\u80FD\u6703\u5728\u6700\u4F73\u6642\u6A5F\u81EA\u52D5\u91CB\u653E\u3002\r\n\u8FD9\u662F\u4F60\u7684\u6307\u5357\u9488\uFF01\u5B8C\u6210\u4EFB\u52A1\u9886\u53D6\u5956\u52B1\uFF0C\u8FD9\u662F\u77E5\u9053\u4E0B\u4E00\u6B65\u8BE5\u53BB\u54EA\u91CC\u7684\u6700\u5FEB\u65B9\u6CD5\u3002\t\u9019\u662F\u4F60\u7684\u6307\u5357\u91DD\uFF01\u5B8C\u6210\u4EFB\u52D9\u9818\u53D6\u734E\u52F5\uFF0C\u9019\u662F\u77E5\u9053\u4E0B\u4E00\u6B65\u8A72\u53BB\u54EA\u88E1\u7684\u6700\u5FEB\u65B9\u6CD5\u3002\r\n\u8DDF\u7740\u4EFB\u52A1\u8D70\uFF0C\u5C31\u6C38\u8FDC\u4E0D\u4F1A\u5728\u5927\u6D77\u4E0A\u8FF7\u8DEF\uFF0C\u5C0F\u5B50\uFF01\t\u8DDF\u8457\u4EFB\u52D9\u8D70\uFF0C\u5C31\u6C38\u9060\u4E0D\u6703\u5728\u5927\u6D77\u4E0A\u8FF7\u8DEF\uFF0C\u5C0F\u5B50\uFF01\r\n\u5B8C\u6210\u5566\uFF01\u5FEB\u9886\u53D6\u5956\u52B1\u5427\uFF0C\u6218\u5229\u54C1\u53EF\u4E0D\u4F1A\u81EA\u5DF1\u8DD1\u8FDB\u4F60\u7684\u80CC\u5305\uFF01\t\u5B8C\u6210\u5566\uFF01\u5FEB\u9818\u53D6\u734E\u52F5\u5427\uFF0C\u6230\u5229\u54C1\u53EF\u4E0D\u6703\u81EA\u5DF1\u8DD1\u9032\u4F60\u7684\u80CC\u5305\uFF01\r\n\u4E0D\u9519\u7684\u6218\u5229\u54C1\uFF01\u5FEB\u628A\u5B83\u6536\u8FDB\u8239\u8231\u4FDD\u7BA1\u597D\u5427\uFF01\t\u4E0D\u932F\u7684\u6230\u5229\u54C1\uFF01\u5FEB\u628A\u5B83\u6536\u9032\u8239\u8259\u4FDD\u7BA1\u597D\u5427\uFF01\r\n\u662F\u65F6\u5019\u62DB\u52DF\u8239\u5458\u4E86\uFF01\u524D\u5F80\u53EC\u5524\u5927\u5385\u62DB\u52DF\u65B0\u7684\u82F1\u96C4\u5427\uFF01\t\u662F\u6642\u5019\u62DB\u52DF\u8239\u54E1\u4E86\uFF01\u524D\u5F80\u53EC\u559A\u5927\u5EF3\u62DB\u52DF\u65B0\u7684\u82F1\u96C4\u5427\uFF01\r\n\u8239\u5458\u8D8A\u591A\uFF0C\u6218\u8239\u8D8A\u5F3A\uFF01\u51FA\u53D1\u5427\uFF0C\u5C0F\u5B50\uFF01\t\u8239\u54E1\u8D8A\u591A\uFF0C\u6230\u8239\u8D8A\u5F37\uFF01\u51FA\u767C\u5427\uFF0C\u5C0F\u5B50\uFF01\r\n\u9009\u62E9\u4F60\u559C\u6B22\u7684\u82F1\u96C4\u7C7B\u578B\u5F00\u59CB\u53EC\u5524\u5427\uFF01\u6D77\u4E0A\u7684\u5E78\u8FD0\uFF0C\u8BF4\u4E0D\u5B9A\u9A6C\u4E0A\u5C31\u62BD\u5230\u7A00\u6709\u82F1\u96C4\uFF01\t\u9078\u64C7\u4F60\u559C\u6B61\u7684\u82F1\u96C4\u985E\u578B\u958B\u59CB\u53EC\u559A\u5427\uFF01\u6D77\u4E0A\u7684\u5E78\u904B\uFF0C\u8AAA\u4E0D\u5B9A\u99AC\u4E0A\u5C31\u62BD\u5230\u7A00\u6709\u82F1\u96C4\uFF01\r\n\u6765\u5427\uFF0C\u8BD5\u8BD5\u8FD0\u6C14\uFF01\u5927\u98CE\u5927\u6D6A\u624D\u6709\u5927\u6536\u83B7\uFF01\t\u4F86\u5427\uFF0C\u8A66\u8A66\u904B\u6C23\uFF01\u5927\u98A8\u5927\u6D6A\u624D\u6709\u5927\u6536\u7A6B\uFF01\r\n\u54C7\uFF01\u5FEB\u770B\u6211\u4EEC\u62BD\u5230\u4E86\u8C01\uFF01\u4E00\u4F4D\u5F3A\u5927\u7684\u6218\u58EB\u52A0\u5165\u4F60\u7684\u8239\u5458\uFF01\u8FD0\u6C14\u771F\u4E0D\u9519\uFF01\t\u54C7\uFF01\u5FEB\u770B\u6211\u5011\u62BD\u5230\u4E86\u8AB0\uFF01\u4E00\u4F4D\u5F37\u5927\u7684\u6230\u58EB\u52A0\u5165\u4F60\u7684\u8239\u54E1\uFF01\u904B\u6C23\u771F\u4E0D\u932F\uFF01\r\n\u7A00\u6709\u82F1\u96C4\u5230\u624B\u4E86\uFF01\u53EF\u522B\u9519\u8FC7\uFF01\t\u7A00\u6709\u82F1\u96C4\u5230\u624B\u4E86\uFF01\u53EF\u5225\u932F\u904E\uFF01\r\n\u65B0\u8239\u5458\u6765\u4E86\uFF0C\u5F53\u7136\u5F97\u7ED9\u4ED6\u5B89\u6392\u4E2A\u4F4D\u7F6E\uFF01\u70B9\u51FB\u82F1\u96C4\u533A\u57DF\u8C03\u6574\u9635\u5BB9\u5427\uFF01\t\u65B0\u8239\u54E1\u4F86\u4E86\uFF0C\u7576\u7136\u5F97\u7D66\u4ED6\u5B89\u6392\u500B\u4F4D\u7F6E\uFF01\u9EDE\u64CA\u82F1\u96C4\u5340\u57DF\u8ABF\u6574\u9663\u5BB9\u5427\uFF01\r\n\u9635\u5BB9\u5B89\u6392\u59A5\u5F53\uFF0C\u51FA\u6D77\u624D\u80FD\u4E00\u8DEF\u987A\u98CE\uFF01\t\u9663\u5BB9\u5B89\u6392\u59A5\u7576\uFF0C\u51FA\u6D77\u624D\u80FD\u4E00\u8DEF\u9806\u98A8\uFF01\r\n\u628A\u65B0\u8239\u5458\u52A0\u5165\u9635\u5BB9\u5427\uFF01\u5C06\u4ED6\u62D6\u5230\u7A7A\u4F4D\u4E0A\uFF0C\u6709\u7A7A\u4F4D\u5C31\u5F97\u586B\u6EE1\uFF01\t\u628A\u65B0\u8239\u54E1\u52A0\u5165\u9663\u5BB9\u5427\uFF01\u5C07\u4ED6\u62D6\u5230\u7A7A\u4F4D\u4E0A\uFF0C\u6709\u7A7A\u4F4D\u5C31\u5F97\u586B\u6EFF\uFF01\r\n\u961F\u4F0D\u4EBA\u6570\u9F50\u5168\uFF0C\u6218\u529B\u81EA\u7136\u8E6D\u8E6D\u4E0A\u6DA8\uFF01\t\u968A\u4F0D\u4EBA\u6578\u9F4A\u5168\uFF0C\u6230\u529B\u81EA\u7136\u8E6D\u8E6D\u4E0A\u6F32\uFF01\r\n\u9635\u5BB9\u5F88\u4E0D\u9519\u561B\uFF0C\u5C0F\u8239\u957F\uFF01\u7EE7\u7EED\u6DF1\u5165\uFF0C\u8BD5\u8BD5\u65B0\u961F\u4F0D\u7684\u5B9E\u529B\uFF0C\u7B2C\u4E8C\u5C42\u6B63\u7B49\u7740\u4F60\uFF01\t\u9663\u5BB9\u5F88\u4E0D\u932F\u561B\uFF0C\u5C0F\u8239\u9577\uFF01\u7E7C\u7E8C\u6DF1\u5165\uFF0C\u8A66\u8A66\u65B0\u968A\u4F0D\u7684\u5BE6\u529B\uFF0C\u7B2C\u4E8C\u5C64\u6B63\u7B49\u8457\u4F60\uFF01\r\n\u626C\u5E06\u524D\u8FDB\uFF0C\u5B9D\u85CF\u5C31\u5728\u524D\u65B9\uFF01\t\u63DA\u5E06\u524D\u9032\uFF0C\u5BF6\u85CF\u5C31\u5728\u524D\u65B9\uFF01\r\n\u8FD8\u60F3\u53D8\u5F97\u66F4\u5F3A\u5417\uFF1F\u6765\u8FD9\u91CC\u63D0\u5347\u5168\u961F\u5C5E\u6027\u5427\uFF0C\u597D\u8239\u4E5F\u5F97\u7ECF\u5E38\u4FDD\u517B\uFF01\t\u9084\u60F3\u8B8A\u5F97\u66F4\u5F37\u55CE\uFF1F\u4F86\u9019\u88E1\u63D0\u5347\u5168\u968A\u5C6C\u6027\u5427\uFF0C\u597D\u8239\u4E5F\u5F97\u7D93\u5E38\u4FDD\u990A\uFF01\r\n\u6295\u8D44\u529B\u91CF\u6C38\u8FDC\u4E0D\u4F1A\u5403\u4E8F\uFF0C\u5C0F\u5B50\uFF01\t\u6295\u8CC7\u529B\u91CF\u6C38\u9060\u4E0D\u6703\u5403\u8667\uFF0C\u5C0F\u5B50\uFF01\r\n\u9009\u62E9\u4F60\u60F3\u5F3A\u5316\u7684\u5C5E\u6027\uFF0C\u7136\u540E\u70B9\u51FB\u5347\u7EA7\uFF01\u653B\u51FB\u3001\u751F\u547D\u90FD\u53EF\u4EE5\uFF0C\u6309\u4F60\u559C\u6B22\u7684\u6218\u6597\u65B9\u5F0F\u6765\u57F9\u517B\u5427\uFF01\t\u9078\u64C7\u4F60\u60F3\u5F37\u5316\u7684\u5C6C\u6027\uFF0C\u7136\u5F8C\u9EDE\u64CA\u5347\u7D1A\uFF01\u653B\u64CA\u3001\u751F\u547D\u90FD\u53EF\u4EE5\uFF0C\u6309\u4F60\u559C\u6B61\u7684\u6230\u9B25\u65B9\u5F0F\u4F86\u57F9\u990A\u5427\uFF01\r\n\u518D\u63D0\u5347\u4E00\u70B9\u529B\u91CF\u5427\uFF0C\u53D8\u5F3A\u6C38\u8FDC\u4E0D\u5ACC\u591A\uFF01\t\u518D\u63D0\u5347\u4E00\u9EDE\u529B\u91CF\u5427\uFF0C\u8B8A\u5F37\u6C38\u9060\u4E0D\u5ACC\u591A\uFF01\r\n\u4FDD\u517B\u5B8C\u6210\uFF01\u56DE\u5230\u7532\u677F\u4E0A\u5427\u3002\u70B9\u51FB\u9000\u51FA\u8FD4\u56DE\u6218\u573A\u3002\t\u4FDD\u990A\u5B8C\u6210\uFF01\u56DE\u5230\u7532\u677F\u4E0A\u5427\u3002\u9EDE\u64CA\u9000\u51FA\u8FD4\u56DE\u6230\u5834\u3002\r\n\u73B0\u5728\u66F4\u5F3A\u4E86\uFF0C\u53BB\u8BA9\u90A3\u4E9B\u602A\u7269\u89C1\u8BC6\u4E00\u4E0B\u5427\uFF01\t\u73FE\u5728\u66F4\u5F37\u4E86\uFF0C\u53BB\u8B93\u90A3\u4E9B\u602A\u7269\u898B\u8B58\u4E00\u4E0B\u5427\uFF01\r\n\u611F\u89C9\u5230\u5DEE\u522B\u4E86\u5417\uFF1F\u4F60\u7684\u961F\u4F0D\u73B0\u5728\u6240\u5411\u62AB\u9761\uFF0C\u8FD9\u5C31\u662F\u52E4\u594B\u8239\u957F\u7684\u6210\u679C\uFF01\t\u611F\u89BA\u5230\u5DEE\u5225\u4E86\u55CE\uFF1F\u4F60\u7684\u968A\u4F0D\u73FE\u5728\u6240\u5411\u62AB\u9761\uFF0C\u9019\u5C31\u662F\u52E4\u596E\u8239\u9577\u7684\u6210\u679C\uFF01\r\n\u7167\u8FD9\u4E2A\u52BF\u5934\uFF0C\u5854\u9876\u5F88\u5FEB\u5C31\u8FD1\u5728\u773C\u524D\u4E86\uFF01\t\u7167\u9019\u500B\u52E2\u982D\uFF0C\u5854\u9802\u5F88\u5FEB\u5C31\u8FD1\u5728\u773C\u524D\u4E86\uFF01\r\n\u5F3A\u5927\u7684\u82F1\u96C4\u5F53\u7136\u9700\u8981\u5F3A\u529B\u6B66\u5668\uFF01\u524D\u5F80\u6B66\u5668\u53EC\u5524\uFF0C\u8BA9\u6211\u4EEC\u7684\u6B66\u5668\u5E93\u6EE1\u8D77\u6765\u5427\uFF01\t\u5F37\u5927\u7684\u82F1\u96C4\u7576\u7136\u9700\u8981\u5F37\u529B\u6B66\u5668\uFF01\u524D\u5F80\u6B66\u5668\u53EC\u559A\uFF0C\u8B93\u6211\u5011\u7684\u6B66\u5668\u5EAB\u6EFF\u8D77\u4F86\u5427\uFF01\r\n\u8D64\u624B\u7A7A\u62F3\u600E\u4E48\u6253\u5F97\u8FC7\u5927\u602A\u7269\uFF1F\u53BB\u5F04\u70B9\u88C5\u5907\u5427\uFF01\t\u8D64\u624B\u7A7A\u62F3\u600E\u9EBC\u6253\u5F97\u904E\u5927\u602A\u7269\uFF1F\u53BB\u5F04\u9EDE\u88DD\u5099\u5427\uFF01\r\n\u9009\u62E9\u6B66\u5668\u7C7B\u578B\u5F00\u59CB\u53EC\u5524\u5427\uFF01\u5251\u3001\u67AA\u3001\u6CD5\u6756\u5E94\u6709\u5C3D\u6709\uFF0C\u8D81\u624B\u7684\u5C31\u662F\u597D\u6B66\u5668\uFF01\t\u9078\u64C7\u6B66\u5668\u985E\u578B\u958B\u59CB\u53EC\u559A\u5427\uFF01\u528D\u3001\u69CD\u3001\u6CD5\u6756\u61C9\u6709\u76E1\u6709\uFF0C\u8D81\u624B\u7684\u5C31\u662F\u597D\u6B66\u5668\uFF01\r\n\u518D\u591A\u53EC\u5524\u51E0\u4EF6\u5427\uFF0C\u597D\u88C5\u5907\u6C38\u8FDC\u4E0D\u5ACC\u591A\uFF01\t\u518D\u591A\u53EC\u559A\u5E7E\u4EF6\u5427\uFF0C\u597D\u88DD\u5099\u6C38\u9060\u4E0D\u5ACC\u591A\uFF01\r\n\u5FEB\u770B\u8FD9\u4EF6\u6B66\u5668\uFF01\u950B\u5229\u65E0\u6BD4\uFF01\u9A6C\u4E0A\u7ED9\u82F1\u96C4\u88C5\u5907\u4E0A\uFF0C\u5B9E\u529B\u7ACB\u523B\u8D77\u98DE\uFF01\t\u5FEB\u770B\u9019\u4EF6\u6B66\u5668\uFF01\u92D2\u5229\u7121\u6BD4\uFF01\u99AC\u4E0A\u7D66\u82F1\u96C4\u88DD\u5099\u4E0A\uFF0C\u5BE6\u529B\u7ACB\u523B\u8D77\u98DB\uFF01\r\n\u8FD9\u4E48\u597D\u7684\u6B66\u5668\u4E0D\u7528\uFF0C\u7B80\u76F4\u592A\u6D6A\u8D39\u4E86\uFF01\t\u9019\u9EBC\u597D\u7684\u6B66\u5668\u4E0D\u7528\uFF0C\u7C21\u76F4\u592A\u6D6A\u8CBB\u4E86\uFF01\r\n\u6709\u88C5\u5907\u5F53\u7136\u5F97\u7A7F\u4E0A\uFF0C\u96BE\u9053\u7559\u7740\u6B23\u8D4F\u5417\uFF1F\u70B9\u51FB\u88C5\u5907\u533A\u57DF\uFF0C\u4E3A\u961F\u4F0D\u88C5\u4E0A\u6B66\u5668\u5427\uFF01\t\u6709\u88DD\u5099\u7576\u7136\u5F97\u7A7F\u4E0A\uFF0C\u96E3\u9053\u7559\u8457\u6B23\u8CDE\u55CE\uFF1F\u9EDE\u64CA\u88DD\u5099\u5340\u57DF\uFF0C\u70BA\u968A\u4F0D\u88DD\u4E0A\u6B66\u5668\u5427\uFF01\r\n\u88C5\u4E0A\u88C5\u5907\uFF0C\u6218\u529B\u9A6C\u4E0A\u7FFB\u500D\uFF01\t\u88DD\u4E0A\u88DD\u5099\uFF0C\u6230\u529B\u99AC\u4E0A\u7FFB\u500D\uFF01\r\n\u9009\u62E9\u4F60\u60F3\u88C5\u5907\u7684\u6B66\u5668\u69FD\u4F4D\u5427\uFF01\u6BCF\u4F4D\u82F1\u96C4\u90FD\u6709\u9002\u5408\u81EA\u5DF1\u7684\u6B66\u5668\uFF0C\u53EF\u8981\u597D\u597D\u6311\u9009\uFF01\t\u9078\u64C7\u4F60\u60F3\u88DD\u5099\u7684\u6B66\u5668\u6B04\u4F4D\u5427\uFF01\u6BCF\u4F4D\u82F1\u96C4\u90FD\u6709\u9069\u5408\u81EA\u5DF1\u7684\u6B66\u5668\uFF0C\u53EF\u8981\u597D\u597D\u6311\u9078\uFF01\r\n\u522B\u8BA9\u8FD9\u4E48\u597D\u7684\u6B66\u5668\u8EBA\u5728\u8239\u8231\u91CC\u5403\u7070\uFF01\t\u5225\u8B93\u9019\u9EBC\u597D\u7684\u6B66\u5668\u8EBA\u5728\u8239\u8259\u88E1\u5403\u7070\uFF01\r\n\u8FD9\u91CC\u5C31\u662F\u4F60\u7684\u80CC\u5305\uFF01\u6311\u9009\u6700\u597D\u7684\u6B66\u5668\u88C5\u5907\u4E0A\uFF0C\u5C5E\u6027\u9A6C\u4E0A\u5927\u5E45\u63D0\u5347\uFF01\t\u9019\u88E1\u5C31\u662F\u4F60\u7684\u80CC\u5305\uFF01\u6311\u9078\u6700\u597D\u7684\u6B66\u5668\u88DD\u5099\u4E0A\uFF0C\u5C6C\u6027\u99AC\u4E0A\u5927\u5E45\u63D0\u5347\uFF01\r\n\u4ED4\u7EC6\u6311\u9009\uFF0C\u597D\u6B66\u5668\u53EF\u662F\u80FD\u51B3\u5B9A\u6574\u573A\u6218\u6597\u7684\uFF01\t\u4ED4\u7D30\u6311\u9078\uFF0C\u597D\u6B66\u5668\u53EF\u662F\u80FD\u6C7A\u5B9A\u6574\u5834\u6230\u9B25\u7684\uFF01\r\n\u88C5\u5907\u5B8C\u6210\uFF0C\u529B\u91CF\u6EE1\u6EE1\u554A\uFF0C\u5C0F\u8239\u957F\uFF01\u8BE5\u6559\u7684\u6211\u90FD\u6559\u4E86\uFF0C\u73B0\u5728\u5C31\u81EA\u7531\u95EF\u8361\u5427\uFF01\t\u88DD\u5099\u5B8C\u6210\uFF0C\u529B\u91CF\u6EFF\u6EFF\u554A\uFF0C\u5C0F\u8239\u9577\uFF01\u8A72\u6559\u7684\u6211\u90FD\u6559\u4E86\uFF0C\u73FE\u5728\u5C31\u81EA\u7531\u95D6\u8569\u5427\uFF01\r\n\u5E7F\u9614\u7684\u5927\u6D77\u6B63\u7B49\u7740\u4F60\uFF0C\u6709\u9700\u8981\u5C31\u53EB\u6211\u3002\u626C\u5E06\u51FA\u53D1\u5427\u2014\u2014\uFF01\t\u5EE3\u95CA\u7684\u5927\u6D77\u6B63\u7B49\u8457\u4F60\uFF0C\u6709\u9700\u8981\u5C31\u53EB\u6211\u3002\u63DA\u5E06\u51FA\u767C\u5427\u2014\u2014\uFF01\r\n\u5723\u5251\u8D2F\u7A7F\t\u8056\u528D\u8CAB\u7A7F\r\n\u795E\u5251\u5929\u964D\t\u795E\u528D\u5929\u964D\r\n\u5F71\u88AD\t\u5F71\u8972\r\n\u5251\u5203\u65CB\u6DA1\t\u528D\u5203\u65CB\u6E26\r\n\u5E7B\u5F71\u5927\u65A9\t\u5E7B\u5F71\u5927\u65AC\r\n\u5251\u5203\u98CE\u66B4\t\u528D\u5203\u98A8\u66B4\r\n\u81F4\u547D\u5370\u8BB0\u7206\u53D1\t\u81F4\u547D\u5370\u8A18\u7206\u767C\r\n\u6697\u5F71\u7206\u65A9\t\u6697\u5F71\u7206\u65AC\r\n\u6697\u5F71\u65A9\u57DF\t\u6697\u5F71\u65AC\u57DF\r\n\u5343\u5F71\u9886\u57DF\t\u5343\u5F71\u9818\u57DF\r\n\u52A0\u5C14\u6C40\u5723\u7BAD\t\u52A0\u723E\u6C40\u8056\u7BAD\r\n\u96F7\u9F99\t\u96F7\u9F8D\r\n\u51E4\u51F0\t\u9CF3\u51F0\r\n\u96F7\u66B4\t\u96F7\u66B4\r\n\u98CE\u66B4\u7BAD\u96E8\t\u98A8\u66B4\u7BAD\u96E8\r\n\u56DE\u54CD\u4E4B\u7BAD\t\u56DE\u97FF\u4E4B\u7BAD\r\n\u51B0\u82B1\u5149\u675F\t\u51B0\u82B1\u5149\u675F\r\n\u865A\u7A7A\u96F7\u964D\t\u865B\u7A7A\u96F7\u964D\r\n\u51B0\u971C\u65B0\u661F\u7262\u72F1\t\u51B0\u971C\u65B0\u661F\u7262\u7344\r\n\u5730\u72F1\u9668\u77F3\u96E8\t\u5730\u7344\u9695\u77F3\u96E8\r\n\u6DF1\u6E0A\u5F15\u529B\u5D29\u584C\t\u6DF1\u6DF5\u5F15\u529B\u5D29\u584C\r\n\u5929\u7A79\u68F1\u955C\u98CE\u66B4\t\u5929\u7A79\u7A1C\u93E1\u98A8\u66B4\r\n\u4ECE\u7A7A\u95F4\u4F20\u9001\u95E8\u4E2D\u53EC\u5524\u5E7B\u5F71\u4E4B\u5203\uFF0C\u51B2\u5411\u654C\u4EBA\u5E76\u8FDE\u7EED\u65A9\u51FB\uFF0C\u6BCF\u6B21\u9020\u6210
      <color=#FF8A3D>{0}%</color>\u653B\u51FB\u7684\u6280\u80FD\u4F24\u5BB3\u3002\u968F\u540E\u91CA\u653EX\u5F62\u7EC8\u7ED3\u65A9\uFF0C\u5BF9\u4E3B\u76EE\u6807\u5468\u56F4\u7684\u654C\u4EBA\u989D\u5916\u9020\u6210
      <color=#FF8A3D>{1}% </color>\u653B\u51FB\u7684\u6280\u80FD\u4F24\u5BB3\u3002\t\u5F9E\u7A7A\u9593\u50B3\u9001\u9580\u4E2D\u53EC\u559A\u5E7B\u5F71\u4E4B\u5203\uFF0C\u885D\u5411\u6575\u4EBA\u4E26\u9023\u7E8C\u65AC\u64CA\uFF0C\u6BCF\u6B21\u9020\u6210
      <color=#FF8A3D>{0}%</color>\u653B\u64CA\u7684\u6280\u80FD\u50B7\u5BB3\u3002\u96A8\u5F8C\u65BD\u653EX\u5F62\u7D42\u7D50\u65AC\uFF0C\u5C0D\u4E3B\u8981\u76EE\u6A19\u5468\u570D\u7684\u6575\u4EBA\u984D\u5916\u9020\u6210
      <color=#FF8A3D>{1}% </color>\u653B\u64CA\u7684\u6280\u80FD\u50B7\u5BB3\u3002\r\n\u53EC\u5524\u5723\u5251\u843D\u5411\u654C\u4EBA\u533A\u57DF\uFF0C\u8FDE\u7EED\u9020\u6210\u591A\u8F6E\u4F24\u5BB3\u3002\u6BCF\u628A\u5723\u5251\u5BF9\u5F71\u54CD\u8303\u56F4\u5185\u7684\u654C\u4EBA\u9020\u6210
      <color=#FF8A3D>{0}%</color>\u653B\u51FB\u7684\u6280\u80FD\u4F24\u5BB3\u3002\t\u53EC\u559A\u8056\u528D\u843D\u5411\u6575\u4EBA\u5340\u57DF\uFF0C\u9023\u7E8C\u9020\u6210\u591A\u8F2A\u50B7\u5BB3\u3002\u6BCF\u628A\u8056\u528D\u5C0D\u5F71\u97FF\u7BC4\u570D\u5167\u7684\u6575\u4EBA\u9020\u6210
      <color=#FF8A3D>{0}%</color>\u653B\u64CA\u7684\u6280\u80FD\u50B7\u5BB3\u3002\r\n\u53EC\u5524\u5723\u5251\u843D\u5411\u654C\u4EBA\u533A\u57DF\uFF0C\u8FDE\u7EED\u9020\u6210\u591A\u8F6E\u4F24\u5BB3\u3002\u6BCF\u628A\u5723\u5251\u5BF9\u5F71\u54CD\u8303\u56F4\u5185\u7684\u654C\u4EBA\u9020\u6210
      <color=#FF8A3D>{0}%</color>\u653B\u51FB\u7684\u6280\u80FD\u4F24\u5BB3\u3002\t\u53EC\u559A\u8056\u528D\u843D\u5411\u6575\u4EBA\u5340\u57DF\uFF0C\u9023\u7E8C\u9020\u6210\u591A\u8F2A\u50B7\u5BB3\u3002\u6BCF\u628A\u8056\u528D\u5C0D\u5F71\u97FF\u7BC4\u570D\u5167\u7684\u6575\u4EBA\u9020\u6210
      <color=#FF8A3D>{0}%</color>\u653B\u64CA\u7684\u6280\u80FD\u50B7\u5BB3\u3002\r\n\u5728\u76EE\u6807\u4F4D\u7F6E\u751F\u6210\u65CB\u8F6C\u5251\u9635\uFF0C\u6301\u7EED\u5BF9\u533A\u57DF\u5185\u7684\u654C\u4EBA\u9020\u6210\u4F24\u5BB3\u3002\u6BCF\u6B21\u9020\u6210
      <color=#FF8A3D>{0}%</color>\u653B\u51FB\u7684\u6280\u80FD\u4F24\u5BB3\uFF0C\u5E76\u6709\u6982\u7387\u4F7F\u654C\u4EBA\u51CF\u901F\u3002\t\u5728\u76EE\u6A19\u4F4D\u7F6E\u751F\u6210\u65CB\u8F49\u528D\u9663\uFF0C\u6301\u7E8C\u5C0D\u5340\u57DF\u5167\u7684\u6575\u4EBA\u9020\u6210\u50B7\u5BB3\u3002\u6BCF\u6B21\u9020\u6210
      <color=#FF8A3D>{0}%</color>\u653B\u64CA\u7684\u6280\u80FD\u50B7\u5BB3\uFF0C\u4E26\u6709\u6A5F\u7387\u4F7F\u6575\u4EBA\u6E1B\u901F\u3002\r\n\u53EC\u5524\u5E7B\u5F71\u4E4B\u5251\u843D\u5411\u76EE\u6807\u533A\u57DF\uFF0C\u8FDE\u7EED\u9020\u6210\u591A\u8F6E\u4F24\u5BB3\u3002\u6BCF\u8F6E\u5BF9\u5F71\u54CD\u8303\u56F4\u5185\u7684\u654C\u4EBA\u9020\u6210
      <color=#FF8A3D>{0}%</color>\u653B\u51FB\u7684\u6280\u80FD\u4F24\u5BB3\u3002\t\u53EC\u559A\u5E7B\u5F71\u4E4B\u528D\u843D\u5411\u76EE\u6A19\u5340\u57DF\uFF0C\u9023\u7E8C\u9020\u6210\u591A\u8F2A\u50B7\u5BB3\u3002\u6BCF\u8F2A\u5C0D\u5F71\u97FF\u7BC4\u570D\u5167\u7684\u6575\u4EBA\u9020\u6210
