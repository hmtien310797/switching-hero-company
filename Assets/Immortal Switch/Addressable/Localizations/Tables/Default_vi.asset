    m_Metadata:
      m_Items: []
  - m_Id: 6834115329179659
    m_Localized: "Giai \u0110i\u1EC7u Th\u1EE7y Tri\u1EC1u"
    m_Metadata:
      m_Items: []
  - m_Id: 6834115329179660
    m_Localized: "Huy\u1EC5n \u1EA2nh H\xE0nh Quy\u1EBFt"
