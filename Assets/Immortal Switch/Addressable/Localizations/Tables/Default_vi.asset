  - m_Id: 5063084587401216
    m_Localized: "Nh\xECn k\xECa! L\u0169 qu\xE1i kia \u0111ang mang theo c\u1EA3
      \u0111\u1ED1ng kho b\xE1u!\nNg\u01B0\u01A1i \u0111\u1EE7 can \u0111\u1EA3m
      \u0111\u1EC3 tham gia c\xF9ng ta \u0111i s\u0103n kho b\xE1u c\u1EE7a l\u0169
      goblin \u0111\xF3 kh\xF4ng?!"
    m_Metadata:
      m_Items: []
