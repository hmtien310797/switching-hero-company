  - m_Id: 6834115329179672
    m_Localized: "Kh\xFAc Nh\u1EA1c \u0110\u1EA1i D\u01B0\u01A1ng"
    m_Metadata:
      m_Items: []
  - m_Id: 7209269083291648
    m_Localized: "Kh\xF4ng \u0111\u1EE7 v\xE9 \u0111\u1EC3 tri\u1EC7u h\u1ED3i Anh
      H\xF9ng.L\u1EA7n tri\u1EC7u h\u1ED3i n\xE0y s\u1EBD ti\xEAu t\u1ED1n {0} Kim
      C\u01B0\u01A1ng.X\xE1c Nh\u1EADn?"
    m_Metadata:
      m_Items: []
  - m_Id: 7209269121040384
    m_Localized: "B\u1ECF Qua"
    m_Metadata:
      m_Items: []
  - m_Id: 7209269121040385
    m_Localized: "\u0110\u1ED3ng \xDD"
    m_Metadata:
      m_Items: []
  - m_Id: 7209269121040386
    m_Localized: "Kh\xF4ng hi\u1EC3n th\u1ECB l\u1EA1i th\xF4ng b\xE1o n\xE0y."
    m_Metadata:
      m_Items: []
  - m_Id: 7209269125234688
    m_Localized: "C\u1EA3nh B\xE1o!"
    m_Metadata:
      m_Items: []
