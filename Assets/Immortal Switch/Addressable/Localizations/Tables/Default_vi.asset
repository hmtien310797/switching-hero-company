    m_Metadata:
      m_Items: []
  - m_Id: 5034138785333253
    m_Localized: "V\u0169 Kh\xED"
    m_Metadata:
      m_Items: []
  - m_Id: 5034138785333254
    m_Localized: "K\u1EF9 N\u0103ng Anh H\xF9ng"
    m_Metadata:
      m_Items: []
  - m_Id: 5034138785333255
    m_Localized: "Sau <color=#94FF40>{0}</color> l\u1EA7n \u0111\xE1nh tr\xFAng,
      Bastet t\u1EA1o V\xF9ng Ch\xFAc Ph\xFAc trong <color=#C58CFF>{1}</color> gi\xE2y,
      t\u0103ng <color=#42D9FF>{2}</color>% T\u1ED1c \u0110\u1ED9 v\xE0 <color=#63E36F>{3}</color>%
      HP cho \u0111\u1ED3ng minh trong v\xF9ng."
    m_Metadata:
      m_Items: []
  - m_Id: 5034138785333256
    m_Localized: "M\u1ED7i l\u1EA7n d\xF9ng k\u1EF9 n\u0103ng nh\u1EADn 1 M\u0169i
      T\xEAn R\u1EEBng. \u0110\u1EE7 <color=#94FF40>{0}</color> m\u0169i s\u1EBD
      t\u1EF1 \u0111\u1ED9ng b\u1EAFn ra, m\u1ED7i m\u0169i g\xE2y <color=#FF8A3D>{1}</color>%
      ATK l\xEAn k\u1EBB \u0111\u1ECBch g\u1EA7n nh\u1EA5t."
    m_Metadata:
      m_Items: []
  - m_Id: 5034138785333257
    m_Localized: "Nh\u1EADn s\u1EB5n <color=#FFD84A>{0}</color>% T\u1EC9 L\u1EC7
      B\u1EA1o K\xEDch. M\u1ED7i l\u1EA7n b\u1EA1o k\xEDch t\u0103ng th\xEAm <color=#94FF40>{1}</color>%
      trong <color=#C58CFF>{2}</color> gi\xE2y, c\u1ED9ng d\u1ED3n t\u1ED1i \u0111a
      <color=#94FF40>{3}</color> t\u1EA7ng."
    m_Metadata:
      m_Items: []
  - m_Id: 5034138785333258
    m_Localized: "Sau <color=#94FF40>{0}</color> \u0111\xF2n \u0111\xE1nh th\u01B0\u1EDDng,
      Ophelia v\xE0o tr\u1EA1ng th\xE1i Th\u1EE7y Tri\u1EC1u D\xE2ng trong <color=#C58CFF>{1}</color>
      gi\xE2y, t\u0103ng <color=#42D9FF>{2}</color>% T\u1ED1c \u0110\u1ED9 v\xE0
      <color=#FF8A3D>{3}</color>% S\xE1t Th\u01B0\u01A1ng Cu\u1ED1i."
    m_Metadata:
      m_Items: []
  - m_Id: 5034138789527552
    m_Localized: "Sau <color=#94FF40>{0}</color> l\u1EA7n k\u1EF9 n\u0103ng \u0111\xE1nh
      tr\xFAng, Hatshepsut v\xE0o tr\u1EA1ng th\xE1i Th\u1ED1ng Tr\u1ECB Sa M\u1EA1c
      trong <color=#C58CFF>{1}</color> gi\xE2y, t\u0103ng <color=#FF8A3D>{2}</color>%
      S\xE1t Th\u01B0\u01A1ng K\u1EF9 N\u0103ng."
    m_Metadata:
      m_Items: []
  - m_Id: 5034138789527553
    m_Localized: "Sau <color=#94FF40>{0}</color> l\u1EA7n k\u1EF9 n\u0103ng \u0111\xE1nh
      tr\xFAng, Brandon-Lowen v\xE0o tr\u1EA1ng th\xE1i H\u1ECFa H\u1ED3n trong <color=#C58CFF>{1}</color>
      gi\xE2y, t\u0103ng <color=#FF8A3D>{2}</color>% S\xE1t Th\u01B0\u01A1ng K\u1EF9
      N\u0103ng."
    m_Metadata:
      m_Items: []
  - m_Id: 5034138789527554
    m_Localized: "Sau <color=#94FF40>{0}</color> \u0111\xF2n \u0111\xE1nh th\u01B0\u1EDDng,
      Robert v\xE0o tr\u1EA1ng th\xE1i Cu\u1ED3ng X\u1EA1 trong <color=#C58CFF>{1}</color>
      gi\xE2y, t\u0103ng <color=#42D9FF>{2}</color>% T\u1ED1c \u0110\u1ED9."
    m_Metadata:
      m_Items: []
  - m_Id: 5034138789527555
    m_Localized: "Sau <color=#94FF40>{0}</color> \u0111\xF2n \u0111\xE1nh th\u01B0\u1EDDng,
      Edward v\xE0o tr\u1EA1ng th\xE1i Cu\u1ED3ng Phong trong <color=#C58CFF>{1}</color>
      gi\xE2y, t\u0103ng <color=#FF8A3D>{2}</color>% ATK v\xE0 <color=#FFD84A>{3}</color>%
      T\u1EC9 L\u1EC7 B\u1EA1o K\xEDch."
    m_Metadata:
      m_Items: []
  - m_Id: 5034138789527556
    m_Localized: "Sau <color=#94FF40>{0}</color> l\u1EA7n k\u1EF9 n\u0103ng g\xE2y
      s\xE1t th\u01B0\u01A1ng ho\u1EB7c h\u1ED3i ph\u1EE5c, Amelia v\xE0o tr\u1EA1ng
      th\xE1i Th\u1EE7y V\u0169 trong <color=#C58CFF>{1}</color> gi\xE2y, t\u0103ng
      <color=#FF8A3D>{2}</color>% S\xE1t Th\u01B0\u01A1ng K\u1EF9 N\u0103ng v\xE0
      <color=#63E36F>{3}</color>% hi\u1EC7u qu\u1EA3 h\u1ED3i ph\u1EE5c."
    m_Metadata:
      m_Items: []
  - m_Id: 5034138789527557
    m_Localized: "Sau <color=#94FF40>{0}</color> \u0111\xF2n \u0111\xE1nh th\u01B0\u1EDDng,
      Jerolur k\xEDch ho\u1EA1t Th\xE1nh Ki\u1EBFm trong <color=#C58CFF>{1}</color>
      gi\xE2y, t\u0103ng <color=#42D9FF>{2}</color>% T\u1ED1c \u0110\u1ED9 v\xE0
      <color=#FFD84A>{3}</color>% T\u1EC9 L\u1EC7 B\u1EA1o K\xEDch."
    m_Metadata:
      m_Items: []
  - m_Id: 5034138789527558
    m_Localized: "Sau <color=#94FF40>{0}</color> \u0111\xF2n \u0111\xE1nh ho\u1EB7c
      k\u1EF9 n\u0103ng tr\xFAng m\u1EE5c ti\xEAu, Riddle k\xEDch ho\u1EA1t Uy Quy\u1EC1n
      Ho\xE0ng Gia trong <color=#C58CFF>{1}</color> gi\xE2y, t\u0103ng <color=#FF8A3D>{2}</color>%
      ATK cho b\u1EA3n th\xE2n v\xE0 \u0111\u1ED3ng minh g\u1EA7n \u0111\xF3."
    m_Metadata:
      m_Items: []
  - m_Id: 5034138789527559
    m_Localized: "M\u1ED7i <color=#94FF40>{0}</color> gi\xE2y nh\u1EADn 1 t\u1EA7ng
      B\u0103ng Gi\xE1p, m\u1ED7i t\u1EA7ng t\u0103ng <color=#6FA8FF>{1}</color>%
      DEF v\xE0 ph\u1EA3n l\u1EA1i s\xE1t th\u01B0\u01A1ng b\u1EB1ng <color=#FF8A3D>{2}</color>%
      ATK. \u0110\u1EE7 <color=#94FF40>{3}</color> t\u1EA7ng nh\u1EADn l\xE1 ch\u1EAFn
      b\u1EB1ng <color=#94FF40>{4}</color>% HP t\u1ED1i \u0111a."
    m_Metadata:
      m_Items: []
  - m_Id: 5034138789527560
    m_Localized: "M\u1ED7i \u0111\xF2n \u0111\xE1nh nh\u1EADn 1 N\u1ED1t N\u01B0\u1EDBc,
      d\xF9ng Tuy\u1EC7t K\u1EF9 nh\u1EADn <color=#94FF40>{0}</color> n\u1ED1t. M\u1ED7i
      n\u1ED1t t\u0103ng <color=#FF8A3D>{1}</color>% S\xE1t Th\u01B0\u01A1ng K\u1EF9
      N\u0103ng; \u0111\u1EE7 <color=#94FF40>{2}</color> n\u1ED1t k\xEDch ho\u1EA1t
      C\u1ED9ng H\u01B0\u1EDFng trong <color=#C58CFF>{3}</color> gi\xE2y."
    m_Metadata:
      m_Items: []
  - m_Id: 5034138793721856
    m_Localized: "Bastet tung <color=#94FF40>{0}</color> \u0111\u1EE3t \xE1m s\xE1t,
      m\u1ED7i \u0111\u1EE3t g\xE2y <color=#FF8A3D>{1}</color>% ATK l\xEAn t\u1ED1i
      \u0111a <color=#94FF40>{2}</color> k\u1EBB \u0111\u1ECBch. Khi k\u1EBFt li\u1EC5u
      m\u1EE5c ti\xEAu, l\u1EADp t\u1EE9c tung th\xEAm 1 \u0111\u1EE3t tr\xEAn to\xE0n
      chi\u1EBFn tr\u01B0\u1EDDng."
    m_Metadata:
      m_Items: []
  - m_Id: 5034138793721857
    m_Localized: "Tri\u1EC7u h\u1ED3i R\u1EEBng C\u1ED5 trong <color=#C58CFF>{0}</color>
      gi\xE2y, t\u1EA1o <color=#94FF40>{1}</color> \u0111\u1EE3t gai g\u1ED7. M\u1ED7i
      \u0111\u1EE3t g\xE2y <color=#FF8A3D>{2}</color>% ATK s\xE1t th\u01B0\u01A1ng
      M\u1ED9c v\xE0 t\u1EF1 \u0111\u1ED5i m\u1EE5c ti\xEAu khi k\u1EBB \u0111\u1ECBch
      b\u1ECB h\u1EA1."
    m_Metadata:
      m_Items: []
  - m_Id: 5034138793721858
    m_Localized: "Emily l\u01B0\u1EDBt xuy\xEAn \u0111\u1ED9i h\xECnh v\xE0 ch\xE9m
      <color=#94FF40>{0}</color> l\u1EA7n, m\u1ED7i l\u1EA7n g\xE2y <color=#FF8A3D>{1}</color>%
      ATK. Sau khi d\xF9ng k\u1EF9 n\u0103ng, t\u0103ng <color=#FFD84A>{2}</color>%
      T\u1EC9 L\u1EC7 B\u1EA1o K\xEDch trong <color=#C58CFF>{3}</color> gi\xE2y."
    m_Metadata:
      m_Items: []
  - m_Id: 5034138793721859
    m_Localized: "B\u1EAFn <color=#94FF40>{0}</color> S\xF3ng Tr\u0103ng xuy\xEAn
      m\u1EE5c ti\xEAu theo h\xECnh qu\u1EA1t, m\u1ED7i s\xF3ng g\xE2y <color=#FF8A3D>{1}</color>%
      ATK. K\u1EBB \u0111\u1ECBch trong v\xF9ng giao nhau c\xF3 th\u1EC3 tr\xFAng
      nhi\u1EC1u l\u1EA7n."
    m_Metadata:
      m_Items: []
  - m_Id: 5034138793721860
    m_Localized: "Tri\u1EC7u h\u1ED3i <color=#94FF40>{0}</color> thi\xEAn th\u1EA1ch
      c\xE1t v\xE0o khu v\u1EF1c \u0111\xF4ng \u0111\u1ECBch nh\u1EA5t, m\u1ED7i
      thi\xEAn th\u1EA1ch g\xE2y <color=#FF8A3D>{1}</color>% ATK l\xEAn m\u1ECDi
      k\u1EBB \u0111\u1ECBch trong v\xF9ng."
    m_Metadata:
      m_Items: []
  - m_Id: 5034138793721861
    m_Localized: "Ph\xF3ng lu\u1ED3ng h\u1ECFa quang trong <color=#C58CFF>{0}</color>
      gi\xE2y, g\xE2y <color=#FF8A3D>{1}</color>% ATK m\u1ED7i <color=#94FF40>{2}</color>
      gi\xE2y l\xEAn m\u1ECDi k\u1EBB \u0111\u1ECBch tr\xEAn \u0111\u01B0\u1EDDng
      th\u1EB3ng."
    m_Metadata:
      m_Items: []
  - m_Id: 5034138793721862
    m_Localized: "X\u1EA3 \u0111\u1EA1n theo h\xECnh n\xF3n trong <color=#C58CFF>{0}</color>
      gi\xE2y v\u1EDBi <color=#94FF40>{1}</color> hit, m\u1ED7i hit g\xE2y <color=#FF8A3D>{2}</color>%
      ATK l\xEAn k\u1EBB \u0111\u1ECBch trong v\xF9ng h\u1ECFa l\u1EF1c."
    m_Metadata:
      m_Items: []
  - m_Id: 5034138793721863
    m_Localized: "T\u1EA1o l\u1ED1c xo\xE1y ziczac xuy\xEAn chi\u1EBFn tr\u01B0\u1EDDng,
      g\xE2y <color=#94FF40>{0}</color> hit; m\u1ED7i hit g\xE2y <color=#FF8A3D>{1}</color>%
      ATK, h\u1EA5t l\xF9i v\xE0 l\xE0m cho\xE1ng <color=#C58CFF>{2}</color> gi\xE2y."
    m_Metadata:
      m_Items: []
  - m_Id: 5034138793721864
    m_Localized: "T\u1EA1o v\xF9ng th\u1EE7y tri\u1EC1u trong <color=#C58CFF>{0}</color>
      gi\xE2y, g\xE2y <color=#94FF40>{1}</color> hit; m\u1ED7i hit g\xE2y <color=#FF8A3D>{2}</color>%
      ATK. Khi k\u1EBFt th\xFAc, ph\xE1t n\u1ED5 g\xE2y th\xEAm <color=#FF8A3D>{3}</color>%
      ATK."
    m_Metadata:
      m_Items: []
  - m_Id: 5034138793721865
    m_Localized: "Tri\u1EC7u h\u1ED3i <color=#94FF40>{0}</color> Th\xE1nh Ki\u1EBFm
      trong <color=#C58CFF>{1}</color> gi\xE2y. M\u1ED7i \u0111\xF2n \u0111\xE1nh
      th\u01B0\u1EDDng ph\xF3ng th\xEAm ki\u1EBFm g\xE2y <color=#FF8A3D>{2}</color>%
      ATK l\xEAn m\u1EE5c ti\xEAu ph\xEDa tr\u01B0\u1EDBc."
    m_Metadata:
      m_Items: []
  - m_Id: 5034138793721866
    m_Localized: "T\u1EA1o V\u01B0\u01A1ng V\u1EF1c trong <color=#C58CFF>{0}</color>
      gi\xE2y: \u0111\u1ED3ng minh trong v\xF9ng t\u0103ng <color=#FF8A3D>{1}</color>%
      ATK v\xE0 <color=#42D9FF>{2}</color>% T\u1ED1c \u0110\u1ED9; k\u1EBB \u0111\u1ECBch
      gi\u1EA3m <color=#6FA8FF>{3}</color>% DEF."
    m_Metadata:
      m_Items: []
  - m_Id: 5034138793721867
    m_Localized: "T\u1EA1o khe n\u1EE9t b\u0103ng g\xE2y <color=#FF8A3D>{0}</color>%
      ATK c\u1ED9ng <color=#FF8A3D>{1}</color>% HP t\u1ED1i \u0111a l\xEAn t\u1ED1i
      \u0111a <color=#94FF40>{2}</color> m\u1EE5c ti\xEAu v\xE0 \u0110\xF3ng B\u0103ng
      trong <color=#C58CFF>{3}</color> gi\xE2y."
    m_Metadata:
      m_Items: []
  - m_Id: 5034138793721868
    m_Localized: "T\u1EA1o <color=#94FF40>{0}</color> l\xE0n s\xF3ng, m\u1ED7i s\xF3ng
      g\xE2y <color=#FF8A3D>{1}</color>% MATK. Sau \u0111\xF3 ph\xE1t n\u1ED5 g\xE2y
      <color=#FF8A3D>{2}</color>% MATK v\xE0 l\xE0m ch\u1EADm <color=#94FF40>{3}</color>%
      trong <color=#C58CFF>{4}</color> gi\xE2y."
    m_Metadata:
      m_Items: []
  - m_Id: 5039769936248832
