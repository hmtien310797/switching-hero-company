    m_Localized: "\u8DDF\u7740\u4EFB\u52A1\u8D70\uFF0C\u5C31\u6C38\u8FDC\u4E0D\u4F1A\u5728\u5927\u6D77\u4E0A\u8FF7\u8DEF\uFF0C\u5C0F\u5B50\uFF01"
